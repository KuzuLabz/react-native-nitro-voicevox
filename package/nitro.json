{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "voicevox"
  ],
  "ios": {
    "iosModuleName": "NitroVoicevox"
  },
  "android": {
    "androidNamespace": [
      "voicevox"
    ],
    "androidCxxLibName": "NitroVoicevox"
  },
  "autolinking": {
    "VoicevoxNitro": {
        "all": {
            "language": "c++",
            "implementationClassName": "HybridVoicevox"
        }
    },
    "VoicevoxFactory": {
        "all": {
            "language": "c++",
            "implementationClassName": "HybridVoicevoxFactory"
        }
    },
    "UserDictNitro": {
        "all": {
            "language": "c++",
            "implementationClassName": "HybridUserDict"
        }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}